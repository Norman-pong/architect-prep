# Architect Prep 环境变量配置
# 复制本文件为 .env，按需修改
#
# dev.sh 和 docker compose 都读这里：
#   - SMTP_HOST=mailpit  -> dev.sh 启动 Mailpit，邮件本地捕获（http://localhost:8025）
#   - SMTP_HOST=smtp.qq.com -> dev.sh 用真实 SMTP 发邮件

# ─── JWT ────────────────────────────────────────────
# 至少 16 字符，生产环境必须修改
# 生成: openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-characters-long

# ─── SMTP（邮箱验证码）──────────────────────────────
# 默认用 Mailpit（本地捕获，需 Docker），验证码查看: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=dev@local
SMTP_PASS=dev
SMTP_FROM=Architect Prep <dev@local>

# 发送真实邮件时改为你的 SMTP（以 QQ 邮箱为例）:
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=your-qq@qq.com
# SMTP_PASS=your-smtp-authorization-code
# SMTP_FROM=Architect Prep <your-qq@qq.com>

# ─── 可选 ───────────────────────────────────────────
SERVER_PORT=8080
# IMAGE_TAG=latest
# GHCR_OWNER=Norman-pong
