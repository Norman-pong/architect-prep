# Architect Prep 环境变量配置
# 复制本文件为 .env，修改后通过 docker compose up -d 加载
#
# 默认值已指向 mailpit（docker-compose.yml 内置），
# 本地测试无需修改即可使用。

# ─── JWT ────────────────────────────────────────────
# 生产环境必须修改：至少 16 字符的随机字符串
# 生成: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production-32chars-min

# ─── SMTP（邮箱验证码）──────────────────────────────
# 默认指向 docker-compose 内置的 mailpit
# 验证码邮件查看: http://localhost:8025

# 生产环境示例（以 QQ 邮箱为例）:
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your-qq@qq.com
# SMTP_PASS=your-smtp-authorization-code
# SMTP_FROM=Architect Prep <your-qq@qq.com>

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=dev@local
SMTP_PASS=dev
SMTP_FROM=Architect Prep <dev@local>

# ─── 可选 ───────────────────────────────────────────
# 镜像标签（默认 latest，可指定 commit SHA）
# IMAGE_TAG=latest

# GHCR 用户名（默认仓库 owner）
# GHCR_OWNER=Norman-pong
